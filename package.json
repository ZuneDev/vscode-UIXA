{
  "name": "uixa",
  "displayName": "Iris UIX",
  "description": "Provides language support for various UIX formats including XML, scripts, and assembly",
  "publisher": "YoshiAsk",
  "repository": {
    "url": "https://github.com/ZuneDev/vscode-UIXA",
    "type": "github"
  },
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "activationEvents": [
    "onDebug",
    "onCommand:extension.uixa.getProgramName"
  ],
  "contributes": {
    "languages": [
      {
        "id": "uixa",
        "aliases": ["UIX Assembly", "uixa"],
        "extensions": [".uixa"],
        "configuration": "./languages/uix_language-configuration.json"
      },
      {
        "id": "uix-script",
        "aliases": ["UIX Script", "uix-script"],
        "extensions": [".uix-script"],
        "configuration": "./languages/uix-script_language-configuration.json"
      },
      {
        "id": "uix-xml",
        "aliases": ["UIX XML", "uix-xml"],
        "extensions": [".uix", ".uix-xml"]
      }
    ],
    "grammars": [
      {
        "language": "uixa",
        "scopeName": "source.uixa",
        "path": "./syntaxes/UIXA.tmLanguage"
      },
      {
        "language": "uix-script",
        "scopeName": "source.uix-script",
        "path": "./syntaxes/uix-script.tmLanguage.json"
      },
      {
        "language": "uix-xml",
        "scopeName": "source.uix-xml",
        "path": "./syntaxes/uix-xml.tmLanguage.json"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "extension.uixa.runEditorContents",
          "when": "resourceLangId == uix-xml",
          "group": "navigation@1"
        },
        {
          "command": "extension.uixa.debugEditorContents",
          "when": "resourceLangId == uix-xml",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "extension.uixa.debugEditorContents",
          "when": "resourceLangId == uix-xml"
        },
        {
          "command": "extension.uixa.runEditorContents",
          "when": "resourceLangId == uix-xml"
        }
      ],
      "debug/variables/context": [
        {
          "command": "extension.uixa.toggleFormatting",
          "when": "debugType == 'iris-uix' && debugProtocolVariableMenuContext == 'simple'"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.uixa.debugEditorContents",
        "title": "Debug File",
        "category": "Iris UIX Debug",
        "enablement": "!inDebugMode",
        "icon": "$(debug-alt)"
      },
      {
        "command": "extension.uixa.runEditorContents",
        "title": "Run File",
        "category": "Iris UIX Debug",
        "enablement": "!inDebugMode",
        "icon": "$(play)"
      },
      {
        "command": "extension.uixa.toggleFormatting",
        "title": "Toggle between decimal and hex formatting"
      }
    ],
    "breakpoints": [
      {
        "language": "uix-xml"
      }
    ],
    "debuggers": [
      {
        "type": "iris-uix",
        "languages": [
          "uix-xml"
        ],
        "label": "Iris UIX Debug",
        "program": "./out/debugAdapter.js",
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to a text file.",
                "default": "${workspaceFolder}/${command:AskForProgramName}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "iris-uix",
            "request": "launch",
            "name": "Ask for file name",
            "program": "${workspaceFolder}/${command:AskForProgramName}",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Iris UIX Debug: Launch",
            "description": "A new configuration for 'debugging' a user selected UIX XML file.",
            "body": {
              "type": "iris-uix",
              "request": "launch",
              "name": "Ask for file name",
              "program": "^\"\\${workspaceFolder}/\\${command:AskForProgramName}\"",
              "stopOnEntry": true
            }
          }
        ],
        "variables": {
          "AskForProgramName": "extension.uixa.getProgramName"
        }
      }
    ]
  }
}
