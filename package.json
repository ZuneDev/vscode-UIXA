{
  "name": "uixa",
  "displayName": "Iris UIX",
  "description": "Provides language support for various UIX formats including XML, scripts, and assembly",
  "publisher": "YoshiAsk",
  "repository": {
    "url": "https://github.com/ZuneDev/vscode-UIXA",
    "type": "github"
  },
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Debuggers",
    "Programming Languages"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.3.3"
  },
  "activationEvents": [
    "onDebugResolve:uix-xml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "uixa",
        "aliases": ["UIX Assembly", "uixa"],
        "extensions": [".uixa"],
        "configuration": "./languages/uix_language-configuration.json"
      },
      {
        "id": "uix-script",
        "aliases": ["UIX Script", "uix-script"],
        "extensions": [".uix-script"],
        "configuration": "./languages/uix-script_language-configuration.json"
      },
      {
        "id": "uix-xml",
        "aliases": ["UIX XML", "uix-xml"],
        "extensions": [".uix", ".uix-xml"]
      }
    ],
    "grammars": [
      {
        "language": "uixa",
        "scopeName": "source.uixa",
        "path": "./syntaxes/UIXA.tmLanguage"
      },
      {
        "language": "uix-script",
        "scopeName": "source.uix-script",
        "path": "./syntaxes/uix-script.tmLanguage.json"
      },
      {
        "language": "uix-xml",
        "scopeName": "source.uix-xml",
        "path": "./syntaxes/uix-xml.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "uix-xml"
      }
    ],
    "debuggers": [
      {
        "type": "uix-xml",
        "label": "Iris UIX Debug",
        "languages": ["uix-xml"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the Iris UIX application.",
                "default": "${workspaceFolder}/iris_app.exe"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Automatically stop after launch.",
                "default": true
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program.",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "Absolute path to the working directory of the program being debugged.",
                "default": "${workspaceFolder}"
              },
              "env": {
                "type": "object",
                "description": "Environment variables passed to the program.",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "uix-xml",
            "request": "launch",
            "name": "Debug Iris UIX Application",
            "program": "${workspaceFolder}/iris_app.exe",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "Iris UIX: Launch",
            "description": "A new configuration for launching an Iris UIX application.",
            "body": {
              "type": "uix-xml",
              "request": "launch",
              "name": "Debug Iris UIX Application",
              "program": "^\"\\${workspaceFolder}/iris_app.exe\"",
              "stopOnEntry": true
            }
          }
        ]
      }
    ]
  }
}